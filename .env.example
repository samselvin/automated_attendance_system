# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/college_attendance?sslmode=require"
# Direct (non-pooled) connection, required by Prisma Migrate
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/college_attendance?sslmode=require"

# ── App ──────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Random 32+ byte secret used to sign session/JWT cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"

# ── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ────
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxxxx"

# ── Access control ──────────────────────────────────────────────────────
# Comma-separated list of email domains allowed to sign in (staff + students).
ALLOWED_EMAIL_DOMAINS="psncet.ac.in"
# Comma-separated list of emails that are always allowed to sign in as Admin,
# even outside ALLOWED_EMAIL_DOMAINS (bootstrap exception — Section 6).
INITIAL_ADMIN_EMAILS="hodaids@psncet.ac.in,samselvinnd11@gmail.com"

# ── Timezone ─────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE="Asia/Kolkata"

# ── SMS provider (DLT-registered, India) ────────────────────────────────
# Use "dev" to log messages to the console/DB instead of sending real SMS.
# Any other value uses the generic HTTP provider in src/lib/sms/provider.ts
# (shaped for MSG91's Flow API by default — adapt that one file if your
# DLT gateway's request/response shape differs).
SMS_PROVIDER="dev"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_DLT_ENTITY_ID=""
SMS_TEMPLATE_ID_FIRST_HOUR_ABSENCE=""
SMS_HTTP_ENDPOINT="https://api.msg91.com/api/v5/flow/"

# ── Background jobs (Vercel Cron — see vercel.json) ─────────────────────
# Vercel sets `Authorization: Bearer <this value>` when it calls a cron
# route; set the same value here so the route can verify the caller.
# Optional locally (routes allow unauthenticated calls outside production).
CRON_SECRET=""

# ── File storage (S3-compatible) ────────────────────────────────────────
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ── Optional integrations ───────────────────────────────────────────────
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=""
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
